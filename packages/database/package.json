{
  "name": "@starform/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-utils": {
      "types": "./src/test-utils.ts",
      "default": "./src/test-utils.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:test": "drizzle-kit push --config=./drizzle.test.config.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "db:nuke": "tsx src/nuke.ts && tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@starform/env": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@starform/typescript-config": "workspace:*",
    "@types/node": "^20.19.41",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "type": "module"
}
